{
  "name": "@abrahamahn/auth-totp",
  "version": "0.1.0",
  "description": "Storage-neutral TOTP enrollment, verification, and recovery-code primitives",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Abraham Joongwhan Ahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/auth-core.git",
    "directory": "typescript-totp"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "type-check": "pnpm typecheck",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "prepack": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "otpauth": "^9.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.26.2"
}
