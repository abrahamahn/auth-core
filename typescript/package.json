{
  "name": "@abrahamahn/auth-core",
  "version": "0.2.0",
  "description": "Storage-neutral authentication, credential, MFA, password, session, and revocation primitives",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Abraham Joongwhan Ahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/auth-core.git",
    "directory": "typescript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "type-check": "pnpm typecheck",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "prepack": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.26.2"
}
